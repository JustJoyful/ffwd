{
  "name": "ffmpeg-agent-browser-spike",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "copy-core": "node scripts/copy-core.mjs",
    "dev": "pnpm copy-core && vite",
    "build": "tsc --noEmit && vite build && node scripts/strip-core.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@mlc-ai/web-llm": "0.2.88"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
