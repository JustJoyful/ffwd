{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffmpeg-agent.dev/protocol/v0.1.0/task",
  "title": "Benchmark/training task (ARCHITECTURE §7.2). gold_spec is null only for ambiguous/unsupported tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "split", "source", "request", "inputs", "gold_spec", "families", "difficulty", "flags", "clarification", "reference_runs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{1,48}$"},
    "split": {"enum": ["dev", "train", "toy"]},
    "source": {"type": "string"},
    "request": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "spec#/$defs/id"}},
    "gold_spec": {"anyOf": [{"$ref": "spec"}, {"type": "null"}]},
    "families": {"type": "array", "minItems": 1, "items": {"$ref": "spec#/$defs/family"}},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 4},
    "flags": {
      "type": "object", "additionalProperties": false, "required": ["ambiguous", "unsupported"],
      "properties": {"ambiguous": {"type": "boolean"}, "unsupported": {"type": "boolean"}}
    },
    "clarification": {"type": ["string", "null"]},
    "reference_runs": {"anyOf": [{"type": "array", "minItems": 1, "items": {"$ref": "action#/$defs/run"}}, {"type": "null"}]}
  }
}
